# --- Flask / app ---
FLASK_SECRET=change-me-in-prod
JWT_SIGNING_KEY=change-me-in-prod-too
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
TRASH_SESSION_TTL_SECONDS=900

# --- Persistence ---
DATABASE_URL=sqlite:///app.db

# --- Blob storage ---
# Leave AZURE_STORAGE_CONNECTION_STRING blank to use the in-process fake store.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=memoryhub-media
# Local fake-blob-store directory (only used when the connection string is blank).
LOCAL_BLOB_DIR=./blobstore

# --- Quota / limits ---
# 5 GB default
DEFAULT_USER_QUOTA_BYTES=5368709120
MAX_AVATAR_BYTES=2097152
TRASH_GRACE_DAYS=30

# --- Google OAuth (Phase 1) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/google/callback

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Misc ---
TRUST_PROXY=0
GIT_SHA=dev
