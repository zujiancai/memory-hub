[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "==3.0.3"
flask-cors = "==4.0.1"
sqlalchemy = ">=2.0,<2.1"
alembic = "==1.13.2"
azure-storage-blob = "==12.22.0"
azure-identity = "==1.17.1"
authlib = "==1.3.2"
"python-jose" = {extras = ["cryptography"], version = "==3.3.0"}
pillow = "==10.4.0"
av = "==12.3.0"
argon2-cffi = "==23.1.0"
python-dotenv = "==1.0.1"
requests = "==2.32.3"
gunicorn = "==22.0.0"

[dev-packages]
pytest = "==8.3.3"
pytest-cov = "==5.0.0"
pytest-flask = "==1.3.0"
responses = "==0.25.3"

[requires]
python_version = "3.11"

[scripts]
server = "flask --app server.app run --debug"
worker = "python -m server.worker"
migrate = "flask --app server.app db upgrade"
test = "pytest"
